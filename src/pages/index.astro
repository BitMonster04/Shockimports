---
import Base from '../layouts/Base.astro';
import dados from '../../public/dados/produtos.json';
const produtos = dados.produtos;
const categorias = dados.categorias;
const base = import.meta.env.BASE_URL;
const dadosJson = JSON.stringify({ produtos, base });
---

<Base titulo="Catálogo Shock Imports">
  <header>
    <div class="header-inner">
      <div class="logo">SH<span class="imports">OCK</span> <span class="imports">IMPORTS</span></div>
      <input type="text" class="busca" id="busca" placeholder="Buscar produto ou código..." />
      <div class="acoes-pdf">
        <button class="botao-pdf" id="botao-baixar" title="Baixar catálogo em PDF">
          Baixar PDF
        </button>
        <button class="botao-pdf botao-secundario" id="botao-compartilhar" title="Compartilhar catálogo">
          Compartilhar
        </button>
      </div>
    </div>
  </header>

  <div class="chips" id="chips">
    <button class="chip ativo" data-categoria="todas">Todas ({produtos.length})</button>
    {categorias.map(cat => {
      const n = produtos.filter(p => p.categoria === cat).length;
      return <button class="chip" data-categoria={cat}>{cat} ({n})</button>;
    })}
  </div>

  <main>
    <div class="grid" id="grid"></div>
    <div class="sem-resultado" id="vazio" style="display:none">
      <strong>Nada encontrado</strong>
      Tente outro termo ou outra categoria.
    </div>
  </main>

  <footer class="rodape">
    Shock Imports Comercial Ltda — Catálogo gerado em {new Date(dados.geradoEm).toLocaleDateString('pt-BR')}
  </footer>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-fechar" id="lightbox-fechar" aria-label="Fechar">×</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>

  <script type="application/json" id="dados-catalogo" set:html={dadosJson} />

  <script>
    const el = document.getElementById('dados-catalogo');
    const { produtos, base } = JSON.parse(el.textContent);
    const baseLimpa = base.replace(/\/$/, '');

    const grid = document.getElementById('grid');
    const vazio = document.getElementById('vazio');
    const busca = document.getElementById('busca');
    const chips = document.getElementById('chips');
    const botaoBaixar = document.getElementById('botao-baixar');
    const botaoCompartilhar = document.getElementById('botao-compartilhar');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxFechar = document.getElementById('lightbox-fechar');

    let categoriaAtual = 'todas';
    let termoBusca = '';

    const fmtPreco = (v) => v === null || v === undefined ? '—' : 'R$ ' + v.toFixed(2).replace('.', ',');

    function slugCategoria(cat) {
      return cat
        .toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    }

    function urlPdfAtual() {
      if (categoriaAtual === 'todas') {
        return baseLimpa + '/pdf/catalogo-completo.pdf';
      }
      return baseLimpa + '/pdf/catalogo-' + slugCategoria(categoriaAtual) + '.pdf';
    }

    function nomePdfAtual() {
      if (categoriaAtual === 'todas') {
        return 'Catalogo-Shock-Imports-Completo.pdf';
      }
      return 'Catalogo-Shock-Imports-' + categoriaAtual.replace(/\s+/g, '-') + '.pdf';
    }

    function escaparHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c]));
    }

    function render() {
      const filtrados = produtos.filter(p => {
        if (categoriaAtual !== 'todas' && p.categoria !== categoriaAtual) return false;
        if (termoBusca) {
          const t = termoBusca.toLowerCase();
          if (!p.nome.toLowerCase().includes(t) && !p.codigo.toLowerCase().includes(t)) return false;
        }
        return true;
      });

      grid.innerHTML = filtrados.map(p => {
        const qtde = p.qtdeCaixa ? `<div class="card-qtde">${p.qtdeCaixa} un/cx</div>` : '';
        const nomeEsc = escaparHtml(p.nome);
        const codigoEsc = escaparHtml(p.codigo);
        return `
        <div class="card">
          <div class="card-img" data-acao="zoom" data-src="${baseLimpa}/${p.imagem}" data-alt="${nomeEsc}">
            <img src="${baseLimpa}/${p.imagem}" alt="${nomeEsc}" loading="lazy" />
          </div>
          <div class="card-info">
            <div class="card-codigo-linha">
              <span class="card-codigo">${codigoEsc}</span>
              <button class="botao-copiar" data-acao="copiar" data-codigo="${codigoEsc}" title="Copiar código" aria-label="Copiar código ${codigoEsc}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
            </div>
            <div class="card-nome">${nomeEsc}</div>
            <div class="card-preco">${fmtPreco(p.preco)}</div>
            ${qtde}
          </div>
        </div>
      `;
      }).join('');

      vazio.style.display = filtrados.length === 0 ? 'block' : 'none';
    }

    busca.addEventListener('input', (e) => {
      termoBusca = e.target.value.trim();
      render();
    });

    chips.addEventListener('click', (e) => {
      const btn = e.target.closest('.chip');
      if (!btn) return;
      chips.querySelectorAll('.chip').forEach(c => c.classList.remove('ativo'));
      btn.classList.add('ativo');
      categoriaAtual = btn.dataset.categoria;
      render();
    });

    // ---------- Clique nos cards: zoom ou copiar ----------
    grid.addEventListener('click', async (e) => {
      const alvo = e.target.closest('[data-acao]');
      if (!alvo) return;

      if (alvo.dataset.acao === 'zoom') {
        abrirLightbox(alvo.dataset.src, alvo.dataset.alt);
      } else if (alvo.dataset.acao === 'copiar') {
        const codigo = alvo.dataset.codigo;
        try {
          await navigator.clipboard.writeText(codigo);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = codigo;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          document.body.removeChild(ta);
        }
        alvo.classList.add('copiado');
        const original = alvo.innerHTML;
        alvo.innerHTML = 'Copiado!';
        setTimeout(() => {
          alvo.classList.remove('copiado');
          alvo.innerHTML = original;
        }, 1500);
      }
    });

    // ---------- Lightbox ----------
    function abrirLightbox(src, alt) {
      lightboxImg.src = src;
      lightboxImg.alt = alt || '';
      lightbox.classList.add('aberto');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function fecharLightbox() {
      lightbox.classList.remove('aberto');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { lightboxImg.src = ''; }, 200);
    }

    lightboxFechar.addEventListener('click', fecharLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) fecharLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.classList.contains('aberto')) fecharLightbox();
    });

    // ---------- Baixar PDF ----------
    botaoBaixar.addEventListener('click', () => {
      const url = urlPdfAtual();
      const nome = nomePdfAtual();
      const a = document.createElement('a');
      a.href = url;
      a.download = nome;
      a.target = '_blank';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });

    // ---------- Compartilhar ----------
    botaoCompartilhar.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: 'Catálogo Shock Imports',
            text: categoriaAtual === 'todas'
              ? 'Confira o catálogo completo da Shock Imports'
              : 'Confira o catálogo de ' + categoriaAtual + ' da Shock Imports',
            url: window.location.href,
          });
        } catch (e) {}
      } else {
        try {
          await navigator.clipboard.writeText(window.location.href);
          botaoCompartilhar.textContent = 'Link copiado!';
          setTimeout(() => {
            botaoCompartilhar.textContent = 'Compartilhar';
          }, 2000);
        } catch (e) {
          alert('Link: ' + window.location.href);
        }
      }
    });

    render();
  </script>
</Base>
